{
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.test)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.production.local)",
      "Read(//**/.env.development.local)",
      "Read(//**/.env.test.local)",
      "Read(//**/.env.staging.local)",
      "Read(//**/.env.production)",
      "Read(//**/*.env)",
      "Read(//**/.envrc)",
      "Read(//**/.envrc.*)",
      "Read(//**/.secrets)",
      "Read(//**/*.secret)",
      "Read(//**/*.secrets)",
      "Read(//**/*.pem)",
      "Read(//**/id_rsa)",
      "Read(//**/credentials.json)",
      "Read(//**/.direnv/**)",
      "Edit(//**/.env)",
      "Edit(//**/.env.local)",
      "Edit(//**/.env.development)",
      "Edit(//**/.env.test)",
      "Edit(//**/.env.staging)",
      "Edit(//**/.env.production.local)",
      "Edit(//**/.env.development.local)",
      "Edit(//**/.env.test.local)",
      "Edit(//**/.env.staging.local)",
      "Edit(//**/.env.production)",
      "Edit(//**/*.env)",
      "Edit(//**/.envrc)",
      "Edit(//**/.envrc.*)",
      "Edit(//**/.secrets)",
      "Edit(//**/*.secret)",
      "Edit(//**/*.secrets)",
      "Edit(//**/*.pem)",
      "Edit(//**/id_rsa)",
      "Edit(//**/credentials.json)",
      "Edit(//**/.direnv/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|MultiEdit|Write|NotebookEdit|Read|Grep|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/run_hook.py\" pre-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/run_hook.py\" post-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/run_hook.py\" stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
