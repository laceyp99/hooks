{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/run_hook.py\" pre-tool",
            "commandWindows": "python \"$HOME/.codex/hooks/run_hook.py\" pre-tool",
            "timeout": 30,
            "statusMessage": "Checking protected paths and dangerous commands"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/run_hook.py\" post-tool",
            "commandWindows": "python \"$HOME/.codex/hooks/run_hook.py\" post-tool",
            "timeout": 30,
            "statusMessage": "Cleaning edited Python files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/run_hook.py\" stop",
            "commandWindows": "python \"$HOME/.codex/hooks/run_hook.py\" stop",
            "timeout": 120,
            "statusMessage": "Running session stop checks"
          }
        ]
      }
    ]
  }
}
